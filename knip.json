{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    "packages/core/stryker.vitest.config.ts",
    "packages/sugar/stryker.vitest.config.ts"
  ],
  "ignoreDependencies": [
    "vite",
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "@typescript/native-preview",
    "@varlock/bumpy"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/bench-compare.mjs"]
    },
    "apps/docs": {
      "entry": ["src/content/docs/*.ts", "src/tutorial/meal-*.ts", "src/design/*.ts"],
      "ignoreDependencies": [
        "@fontsource-variable/ibm-plex-sans",
        "@fontsource-variable/space-grotesk",
        "@fontsource/ibm-plex-mono"
      ]
    },
    "packages/codemod": {
      "ignoreDependencies": ["@mantaq/core"]
    },
    "packages/inspect": {
      "entry": ["src/fixtures/**/*.ts"],
      "ignoreDependencies": ["vitest"]
    }
  }
}
