{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": [
    "packages/core/stryker.vitest.config.ts",
    "packages/sugar/stryker.vitest.config.ts",
    // UI harness build config — not an entry module.
    "packages/viz/browser/vite.config.ts",
    // Static server spawned by the playwright webServer on CI — not an entry.
    "packages/viz/browser/preview-server.mjs"
  ],
  "workspaces": {
    "packages/viz": {
      "entry": ["browser/src/main.tsx"]
    }
  },
  "ignoreDependencies": [
    "vite",
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "@typescript/native-preview",
    "@varlock/bumpy",
    // @mantaq/viz Phase 0: deps land with Phase 1+ code. Remove entries
    // as they become referenced (see packages/viz/package.json).
    "@radix-ui/react-dialog",
    "@radix-ui/react-popover",
    "@radix-ui/react-select",
    "@radix-ui/react-slot",
    "@radix-ui/react-switch",
    "@radix-ui/react-tabs",
    "@radix-ui/react-tooltip",
    "clsx",
    "lucide-react",
    "@testing-library/user-event",
    "@tsdown/css",
    "@vitejs/plugin-react"
  ]
}
