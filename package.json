{
  "name": "mantaq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run guard && vp run bump:check && vp run knip && vp run docs:check && vp run -r test && vp run -r build",
    "guard": "node scripts/vision-guard.mjs",
    "bump:check": "node --test scripts/bump-check.test.mjs && node scripts/bump-check.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "docs:check": "node scripts/docs-check.mjs && node --test scripts/skill-frontmatter.test.mjs && node scripts/skill-check.mjs",
    "knip": "knip",
    "coverage": "vp run -r coverage",
    "bench": "vp run @mantaq/bench#bench",
    "bench:main": "bash scripts/bench-vs-main.sh",
    "bench:baseline": "vp run @mantaq/bench#bench:baseline",
    "dev": "vp run docs#dev",
    "docs:dev": "vp run docs#dev",
    "prepare": "vp config",
    "mutation:core": "stryker run",
    "mutation:sugar": "cd packages/sugar && stryker run",
    "viz:compare": "vp run @mantaq/inspect#viz:compare"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@varlock/bumpy": "catalog:",
    "knip": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0"
}
