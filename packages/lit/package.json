{
  "name": "@mantaq/lit",
  "version": "0.2.0",
  "description": "Bind mantaq actors into lit-html templates with one directive.",
  "keywords": [
    "actor",
    "lit",
    "lit-html",
    "mantaq",
    "state-machine",
    "typescript",
    "ui"
  ],
  "homepage": "https://anderscan.github.io/mantaq/",
  "bugs": {
    "url": "https://github.com/AndersCan/mantaq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/mantaq",
    "directory": "packages/lit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepack": "vp run build"
  },
  "devDependencies": {
    "@mantaq/core": "workspace:^",
    "@typescript/native-preview": "catalog:",
    "happy-dom": "catalog:",
    "lit": "catalog:",
    "lit-html": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@mantaq/core": "workspace:^",
    "lit-html": "^3.3.0"
  }
}
