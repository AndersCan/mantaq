{
  "name": "@mantaq/viz",
  "version": "0.23.0",
  "description": "Draw and walk a Mantaq machine in the browser, from a versioned, deterministic JSON document.",
  "keywords": [
    "actor",
    "diagram",
    "mantaq",
    "state-machine",
    "typescript",
    "viewer",
    "visualizer"
  ],
  "homepage": "https://anderscan.github.io/mantaq/",
  "bugs": {
    "url": "https://github.com/AndersCan/mantaq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/mantaq",
    "directory": "packages/viz"
  },
  "files": [
    "dist",
    "src/viewer/viewer.css",
    "src/viewer/page.css"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./viewer": "./src/viewer/embed.ts",
    "./viewer.css": "./src/viewer/viewer.css",
    "./page.css": "./src/viewer/page.css",
    "./page": "./src/viewer/page.ts",
    "./live": "./src/viewer/live.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./viewer": "./dist/viewer.mjs",
      "./viewer.css": "./src/viewer/viewer.css",
      "./page.css": "./src/viewer/page.css",
      "./page": "./dist/page.mjs",
      "./live": "./dist/live.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "@mantaq/utils": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "happy-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
