---
import { resolve } from "node:path";
import { documents, root } from "virtual:mantaq/documents";

const { src } = Astro.props;
const abs = resolve(root, src);
const doc = documents[abs];
if (doc === undefined) {
  throw new Error(
    `<Machine src="${src}">: not in the machines given to mantaqViz() in astro.config (resolved to ${abs}). Add it to machines.`,
  );
}
if (doc.machines.length === 0) {
  throw new Error(`<Machine src="${src}">: no exported actor or actor factory found in ${abs}`);
}
const bugs = doc.findings.filter((f) => !f.note);
const count = bugs.length;
const unique = (items: string[]) => [...new Set(items)];
const names = (items: string[]) =>
  items.length < 2
    ? (items[0] ?? "")
    : `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
const shown = bugs.slice(0, 6).map((f) => f.title);
const more = bugs.length > 6 ? `; and ${bugs.length - 6} more` : "";
const marked = bugs.some((f) => f.state !== null);
const wide = unique(bugs.filter((f) => f.state === null).map((f) => f.event ?? ""));
---

<section class="mantaq-findings" data-count={count}>
  {
    count > 0 ? (
      <p>
        <strong>
          {count} design finding{count === 1 ? "" : "s"} in {names(unique(bugs.map((f) => f.machine)))}
        </strong>
        : {shown.join("; ")}
        {more}.{marked ? " Click a ! on the diagram to see why." : ""}
        {wide.length > 0
          ? ` ${names(wide)} ${wide.length === 1 ? "is" : "are"} listed at the top of the Details tab.`
          : ""}
      </p>
    ) : (
      <p>No design findings.{doc.fuzzed ? "" : " Fuzzing is off."}</p>
    )
  }
</section>
<div class="mantaq-machine" data-mantaq-viz={doc.text} data-mantaq-src={src}>
  <noscript>The interactive diagram needs JavaScript.</noscript>
</div>
<script>
  import "virtual:mantaq/astro-client";
</script>

<style>
  .mantaq-findings[data-count]:not([data-count="0"]) {
    background: var(--banner-bg, #fff6e0);
    color: var(--banner-fg, #5a3e00);
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
</style>
