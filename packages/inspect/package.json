{
  "name": "@mantaq/inspect",
  "version": "0.35.0",
  "description": "Turn a Mantaq machine into a viz document: structure, handler explanations (AST), fuzz and test coverage. Vite plugin included.",
  "keywords": [
    "actor",
    "astro-integration",
    "diagram",
    "fuzzing",
    "mantaq",
    "state-machine",
    "typescript",
    "visualizer",
    "vite-plugin"
  ],
  "homepage": "https://anderscan.github.io/mantaq/",
  "bugs": {
    "url": "https://github.com/AndersCan/mantaq/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/mantaq",
    "directory": "packages/inspect"
  },
  "bin": {
    "mantaq-check-site": "./src/check-site-cli.ts"
  },
  "files": [
    "dist",
    "src/astro/Machine.astro",
    "src/astro/banner.ts",
    "src/astro/Machines.astro"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./astro": "./src/astro.ts",
    "./astro-client": "./src/astro/client.ts",
    "./drive": "./src/drive.ts",
    "./live-entry": "./src/live-entry.ts",
    "./preview-entry": "./src/preview-entry.ts",
    "./record": "./src/record.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json",
    "./astro/Machine.astro": "./src/astro/Machine.astro",
    "./astro/Machines.astro": "./src/astro/Machines.astro"
  },
  "publishConfig": {
    "bin": {
      "mantaq-check-site": "./dist/check-site-cli.mjs"
    },
    "exports": {
      ".": "./dist/index.mjs",
      "./astro": "./dist/astro.mjs",
      "./astro-client": "./dist/astro-client.mjs",
      "./drive": "./dist/drive.mjs",
      "./live-entry": "./dist/live-entry.mjs",
      "./preview-entry": "./dist/preview-entry.mjs",
      "./record": "./dist/record.mjs",
      "./vite": "./dist/vite.mjs",
      "./package.json": "./package.json",
      "./astro/Machine.astro": "./src/astro/Machine.astro",
      "./astro/Machines.astro": "./src/astro/Machines.astro"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "@mantaq/core": "workspace:*",
    "@mantaq/pbt": "workspace:*",
    "@mantaq/traversal": "workspace:*",
    "@mantaq/utils": "workspace:*",
    "@mantaq/viz": "workspace:*",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@mantaq/sugar": "workspace:*",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "catalog:",
    "astro": "^7.2.0",
    "happy-dom": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "playwright": ">=1.50.0",
    "vite": "*",
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "vite-plus": "1.4.0"
  }
}
