{
  "name": "@mantaq/inspect",
  "version": "0.6.0",
  "description": "Turn a Mantaq machine into a viz document: structure, handler explanations (AST), fuzz and test coverage. Vite plugin included.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndersCan/mantaq",
    "directory": "packages/inspect"
  },
  "files": [
    "dist",
    "src/astro/Machine.astro"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./astro": "./src/astro.ts",
    "./astro-client": "./src/astro/client.ts",
    "./drive": "./src/drive.ts",
    "./live-entry": "./src/live-entry.ts",
    "./record": "./src/record.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json",
    "./astro/Machine.astro": "./src/astro/Machine.astro"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./astro": "./dist/astro.mjs",
      "./astro-client": "./dist/astro-client.mjs",
      "./drive": "./dist/drive.mjs",
      "./live-entry": "./dist/live-entry.mjs",
      "./record": "./dist/record.mjs",
      "./vite": "./dist/vite.mjs",
      "./package.json": "./package.json",
      "./astro/Machine.astro": "./src/astro/Machine.astro"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "viz:export": "node src/examples-cli.ts export",
    "viz:compare": "node src/examples-cli.ts compare",
    "prepublishOnly": "vp run build",
    "prepack": "vp run build"
  },
  "dependencies": {
    "@mantaq/core": "workspace:*",
    "@mantaq/pbt": "workspace:*",
    "@mantaq/traversal": "workspace:*",
    "@mantaq/utils": "workspace:*",
    "@mantaq/viz": "workspace:*",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@mantaq/sugar": "workspace:*",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "catalog:",
    "astro": "^7.2.0",
    "happy-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "vite": "*",
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "vite-plus": "1.4.0"
  }
}
