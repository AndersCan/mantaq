<mantaq-viz id="url-load-demo"></mantaq-viz>

<script>
  import "@mantaq/visualizer";
  import { Actor, state, event, VirtualClock } from "@mantaq/core";

  const idle = state("idle")();
  const loading = state("loading")();
  const success = state("success")();
  const timeoutState = state("timeout")();

  const load = event("LOAD")();
  const loaded = event("LOADED")();
  const timeoutEvt = event("TIMEOUT")();
  const retry = event("RETRY")();
  const reset = event("RESET")();

  const actor = new Actor({
    inputs: [load, loaded, retry, reset],
    outputs: [],
    internal: [timeoutEvt],
    states: [idle, loading, success, timeoutState],
    initial: idle,
    clock: new VirtualClock(),
    context: {} as Record<string, never>,
    effects: {
      loading: [
        (input) => {
          input.clock.setTimeout(3000, () => {
            if (input.signal.aborted) return;
            input.emit({ id: "TIMEOUT" });
          });
        },
      ],
    },
    transitions: {
      idle: { LOAD: () => ({ state: loading }) },
      loading: { LOADED: () => ({ state: success }), TIMEOUT: () => ({ state: timeoutState }) },
      timeout: { RETRY: () => ({ state: loading }) },
      success: { RESET: () => ({ state: idle }) },
    },
  });

  const el = document.getElementById("url-load-demo")! as any;
  el.actor = actor;
</script>
