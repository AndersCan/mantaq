<mantaq-viz id="traffic-light-demo"></mantaq-viz>

<script>
  import "@mantaq/viz";
  import { Actor, state, event } from "@mantaq/core";

  const green = state("green")();
  const yellow = state("yellow")();
  const red = state("red")();
  const next = event("NEXT")();

  const actor = new Actor({
    inputs: [next],
    outputs: [],
    internal: [],
    states: [green, yellow, red],
    initial: green,
    context: {} as {},
    effects: {},
    transitions: {
      green: { NEXT: () => ({ state: yellow }) },
      yellow: { NEXT: () => ({ state: red }) },
      red: { NEXT: () => ({ state: green }) },
    },
  });

  const el = document.getElementById("traffic-light-demo")! as any;
  el.actor = actor;
</script>
