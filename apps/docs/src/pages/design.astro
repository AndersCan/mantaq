---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Badge, Card, CardGrid, Code, LinkButton } from "@astrojs/starlight/components";
import Machine from "@mantaq/inspect/astro/Machine.astro";
import Step from "../components/Step.astro";

const snippet = `import { event, state } from "@mantaq/core";

const cart = state("cart")();
const payment = state("payment")();
const pay = event("pay")();

m.on(cart, { event: pay, to: [payment], handler: () => ({ state: payment }) });`;

const headings = [
  { depth: 2, slug: "headings-and-text", text: "Headings and text" },
  { depth: 2, slug: "tables", text: "Tables" },
  { depth: 2, slug: "inline-code", text: "Inline code" },
  { depth: 2, slug: "code-blocks", text: "Code blocks" },
  { depth: 2, slug: "buttons-and-cards", text: "Buttons and cards" },
  { depth: 2, slug: "diagram", text: "Diagram" },
  { depth: 2, slug: "tutorial-step", text: "Tutorial step: start marker and self-transitions" },
  { depth: 2, slug: "send-form", text: "Send form and Context tab" },
  { depth: 2, slug: "ai-page-label", text: "AI-written page label" },
  { depth: 2, slug: "overlap-warning", text: "Overlap warning" },
  { depth: 2, slug: "group-node", text: "Group node" },
  { depth: 2, slug: "focus-path", text: "Focus path" },
  { depth: 2, slug: "phone-width", text: "Phone width" },
];
---

<StarlightPage
  headings={headings}
  frontmatter={{
    title: "Design: building blocks",
    description: "Every building block the docs use.",
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex" } }],
  }}
>
  <p>
    Internal reference for maintainers. Every building block the docs and the embedded viz use, as
    they look now. A new block, or a new look for a block, appears here first; other pages use it
    only after it is approved here.
  </p>
  <p>
    <strong>Approved</strong>: the maintainer approved this block here (linked).
    <strong>Awaiting approval</strong>: not yet.
  </p>
  <p>Light and dark: use the theme switch at the top. Phone width: see the last section.</p>

  <h2 id="headings-and-text">Headings and text</h2>
  <p><strong>Awaiting approval</strong></p>
  <h3>A third-level heading</h3>
  <h4>A fourth-level heading</h4>
  <p>
    A paragraph with a <a href="/mantaq/">link</a>, <strong>bold</strong> and <em>emphasis</em>.
  </p>
  <ul>
    <li>A bulleted item</li>
    <li>Another bulleted item</li>
  </ul>
  <ol>
    <li>A numbered item</li>
    <li>Another numbered item</li>
  </ol>

  <h2 id="tables">Tables</h2>
  <p><strong>Awaiting approval</strong></p>
  <table>
    <thead>
      <tr><th>Name</th><th>Type</th><th>Meaning</th></tr>
    </thead>
    <tbody>
      <tr><td>id</td><td>string</td><td>Names the machine</td></tr>
      <tr><td>create</td><td>function</td><td>Returns a fresh actor</td></tr>
      <tr><td>source</td><td>object</td><td>Where payload types are read from</td></tr>
    </tbody>
  </table>

  <h2 id="inline-code">Inline code</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>Changed: was smaller than the text around it; now nearly the same size.</p>
  <p>A paragraph with <code>state("checkout")()</code> inside it.</p>
  <ul>
    <li>A list item with <code>event("submit")()</code> inside it</li>
  </ul>
  <table>
    <thead><tr><th>Call</th></tr></thead>
    <tbody><tr><td>A table cell with <code>actor.send(submit)</code></td></tr></tbody>
  </table>
  <h3>A heading with <code>Actor</code></h3>

  <h2 id="code-blocks">Code blocks</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    Changed: was black and white; now syntax colour, with pink for highlighted and added lines.
  </p>
  <Code code={snippet} lang="ts" title="order.ts" mark={[3]} ins={[5]} />
  <Code code="npm install @mantaq/core @mantaq/inspect" lang="sh" />

  <h2 id="buttons-and-cards">Buttons and cards</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    <LinkButton href="/mantaq/" variant="primary">Primary</LinkButton>
    <LinkButton href="/mantaq/" variant="secondary">Secondary</LinkButton>
    <LinkButton href="/mantaq/" variant="minimal">Minimal</LinkButton>
  </p>
  <CardGrid>
    <Card title="Tiny API" icon="star">Three things: state, event, Actor.</Card>
    <Card title="Typed" icon="approve-check">All types inferred from declarations.</Card>
  </CardGrid>

  <h2 id="diagram">Diagram</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    Changed: tabs and controls were smaller than the docs text; now they match it.
  </p>
  <p>A docs paragraph, so the diagram's text size is judged against the text around it.</p>
  <Machine src="src/content/docs/checkout.ts" />

  <p>
    Changed: the Step tab lists the whole walk oldest first, numbers each message
    and marks one nobody took as lost. Put the waiter on a break,
    then cook a dish.
  </p>
  <Machine src="src/design/dropped-message.ts" />

  <h2 id="pool-view">Pool view</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: each live child is a chip with its key on its state, shown at once with no sliding. The Step tab lists every child as a row; click a row or a chip to follow that child, and a click on an arrow sends to it.
  </p>
  <Machine src="src/design/pool.ts" />

  <h2 id="tutorial-step">Tutorial step: start marker and self-transitions</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    Changed: the start marker was a small dot, now a bigger dot with a longer arrow. Loops on one
    state overlapped and their labels collided; now each loop has its own ends, points straight
    down into the state, and its label sits above it.
  </p>
  <Step n={6}>A guard is a plain if in the handler: no plates, no full.</Step>

  <h2 id="blocked-arrow">Blocked arrow</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: an arrow whose guard the current context does not meet is grey with a lock. Changed: a click
    on it sends the event, and the walk stays where the guard keeps it. Here <code>eat</code> is
    blocked until <code>serve</code> puts a plate on the table.
  </p>
  <Step n={6}>
    A guard is a plain if in the handler: no plates, no full. With no plates, eat is blocked: press
    serve first.
  </Step>

  <h2 id="send-form">Send form and Context tab</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: a click on an arrow always sends its event. The <code>?</code> on an arrow opens Details with
    a send form: one box per payload field, holding the values a click sends, and a Send button. A
    change stays for later sends of that event. Changed: the Context tab shows the actor's context,
    read only. Open the <code>?</code> of <code>submitBasicInfo</code> and change
    <code>email</code>.
  </p>
  <Machine src="src/content/docs/checkout.ts" />

  <h2 id="ai-page-label">AI-written page label</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: a page a coding agent wrote shows 🤖 before its title and a 🤖 badge after its name in the
    sidebar. A page with <code>author: human</code> in its frontmatter shows neither. Default is
    <code>ai</code>.
  </p>
  <div class="design-label">
    <p class="design-label-caption">An <code>ai</code> page</p>
    <p class="design-label-title">🤖 Guards</p>
    <p class="design-label-side">Guards <Badge text="🤖" class="ai-badge" /></p>
    <p class="design-label-caption">An <code>author: human</code> page</p>
    <p class="design-label-title">Guards</p>
    <p class="design-label-side">Guards</p>
  </div>

  <h2 id="overlap-warning">Overlap warning</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: when the layout of a machine overlaps itself, the viewer still draws it and adds one
    line to the bar above the drawing. Before, it showed only "Cannot draw" and the machine name.
    Changed: the line was inside the drawing, under it; now it is in the bar, so it does not
    scroll away with the drawing.
  </p>
  <div class="viz">
    <div class="viz-bar">
      <div class="viz-bar-start">
        <p class="overlap-warning">2 overlaps: some labels or lines touch.</p>
      </div>
    </div>
  </div>

  <h2 id="group-node">Group node</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: the states of one group drawn as one node, with its arrows in and out. Under the group name
    it has a box-in-a-box glyph, a row and an enter control. The row says how many states the group
    holds, or which of them the walk is in. Enter draws the states of the group. Here
    <code>chargingCard</code> and <code>confirming</code> are the group <code>payment</code>, and
    the walk is in <code>confirming</code>.
  </p>
  <p>A picture of the block: a click on it does nothing.</p>
  <div class="viz design-sample" inert>
    <svg class="graph" viewBox="0 0 886 170" width="886" height="170" role="group" aria-label="group node sample">
    <defs>
    <marker id="viz-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
    <path d="M0,0 L10,5 L0,10 z" class="arrow-head">
    </path>
    </marker>
    </defs>
    <g class="edge" data-edge-id="inCart-checkout-chargingCard" data-from="inCart" data-to="@payment" aria-label="inCart on checkout to group payment">
    <path class="hit" d="M170.0,85.0 L185.0,85.0 L196.0,85.0 L306.0,85.0 L318.0,85.0 L318.0,109.0 L330.0,109.0 L345.0,109.0" aria-hidden="true">
    </path>
    <path d="M170.0,85.0 L185.0,85.0 L196.0,85.0 L306.0,85.0 L318.0,85.0 L318.0,109.0 L330.0,109.0 L345.0,109.0" marker-end="url(#viz-arrow)">
    </path>
    <text x="251" y="106" text-anchor="middle">
    <tspan x="251" dy="0">checkout</tspan>
    </text>
    </g>
    <g class="edge" data-edge-id="chargingCard-charged-confirming" data-from="@payment" data-to="@payment" aria-label="group payment on charged to group payment">
    <path class="hit" d="M449.0,80.0 L449.0,64.0 L473.0,64.0 L473.0,80.0" aria-hidden="true">
    </path>
    <path d="M449.0,80.0 L449.0,64.0 L473.0,64.0 L473.0,80.0" marker-end="url(#viz-arrow)">
    </path>
    <text x="461" y="52" text-anchor="middle">
    <tspan x="461" dy="0">charged</tspan>
    </text>
    </g>
    <g class="edge" data-edge-id="confirming-confirmed-done" data-from="@payment" data-to="done" aria-label="group payment on confirmed to done">
    <path class="hit" d="M577.0,109.0 L592.0,109.0 L604.0,109.0 L604.0,85.0 L616.0,85.0 L732.0,85.0 L743.0,85.0 L758.0,85.0" aria-hidden="true">
    </path>
    <path d="M577.0,109.0 L592.0,109.0 L604.0,109.0 L604.0,85.0 L616.0,85.0 L732.0,85.0 L743.0,85.0 L758.0,85.0" marker-end="url(#viz-arrow)">
    </path>
    <text x="674" y="106" text-anchor="middle">
    <tspan x="674" dy="0">confirmed</tspan>
    </text>
    </g>
    <g class="entry" aria-hidden="true">
    <circle cx="62" cy="85" r="6">
    </circle>
    <path d="M62,85 L90,85" marker-end="url(#viz-arrow)">
    </path>
    </g>
    <g class="state initial" data-node-id="inCart" aria-label="state inCart">
    <rect x="90" y="67" width="80" height="36" rx="8" class="frame">
    </rect>
    <text x="130" y="89" text-anchor="middle">inCart</text>
    </g>
    <g class="machine-node" data-group="payment">
    <g class="state machine current" data-node-id="@payment" aria-label="group payment, 2 states: chargingCard, confirming" data-states="[&quot;chargingCard&quot;,&quot;confirming&quot;]" data-current-state="confirming">
    <rect x="345" y="80" width="232" height="58" rx="8" class="frame">
    </rect>
    <text x="461" y="101" text-anchor="middle">payment</text>
    <g class="machine-glyph" aria-hidden="true">
    <rect x="357" y="116" width="12" height="12" rx="2">
    </rect>
    <rect class="core" x="360" y="119" width="6" height="6">
    </rect>
    </g>
    <text class="machine-name" data-count="2 states" x="445" y="126" text-anchor="middle">now in confirming</text>
    </g>
    <g class="machine-enter" data-enter-group="@payment" aria-label="enter group payment" tabindex="0" role="button">
    <rect x="521" y="114" width="44" height="16" rx="8">
    </rect>
    <text x="543" y="126" text-anchor="middle">enter</text>
    </g>
    </g>
    <g class="state final" data-node-id="done" aria-label="state done (final)">
    <rect x="758" y="63" width="80" height="44" rx="8" class="frame">
    </rect>
    <rect x="762" y="67" width="72" height="36" rx="5" class="frame inner">
    </rect>
    <text x="798" y="89" text-anchor="middle">done</text>
    </g>
    </svg>
  </div>

  <h2 id="focus-path">Focus path</h2>
  <p><strong>Awaiting approval</strong></p>
  <p>
    New: the path in the bar above the drawing. It starts at the machine the viewer opened on. A
    machine of a board opened adds one crumb, and a group entered adds one more. A click on a crumb
    goes back there, and Escape goes back one level. The last crumb is what the canvas draws now.
    Here the reader opened <code>till</code> on the <code>shop</code> board, then entered the group
    <code>payment</code>.
  </p>
  <p>A picture of the block: a click on it does nothing.</p>
  <div class="viz design-sample" inert>
    <div class="viz-bar">
      <div class="viz-bar-start">
        <nav class="focus-path" aria-label="focus path sample">
          <ol>
            <li><button type="button">shop</button></li>
            <li><button type="button">till</button></li>
            <li><span aria-current="location">payment</span></li>
          </ol>
        </nav>
      </div>
    </div>
  </div>

  <h2 id="phone-width">Phone width</h2>
  <p><strong>Awaiting approval</strong></p>
  <div class="design-phone">
    <p>A paragraph with <code>state("checkout")()</code> inside it.</p>
    <Code code={"const a = 1;\nconst b = 2;"} lang="ts" ins={[2]} />
    <Machine src="src/tutorial/meal-07.ts" />
  </div>
</StarlightPage>

<style>
  .design-sample {
    pointer-events: none;
  }
  .viz.design-sample .machine-enter,
  .viz.design-sample .focus-path button {
    cursor: default;
  }
  .design-phone {
    max-width: 22.5rem;
    border: 1px dashed var(--mq-hairline);
    padding: 0.75rem;
  }
  .design-label {
    border: 1px dashed var(--mq-hairline);
    padding: 0.75rem;
    max-width: 22.5rem;
  }
  .design-label p {
    margin: 0.25rem 0;
  }
  .design-label-title {
    font-size: var(--sl-text-h1);
    font-weight: 600;
  }
  .design-label .design-label-caption {
    margin-top: 1rem;
  }
</style>
