{
  "$schema": "./packages/core/node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["packages/core/src/**/*.ts", "!packages/core/src/virtual-clock.ts"],
  "testFiles": ["packages/core/src/*.property.test.ts", "packages/core/src/*.mutation.test.ts"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress"],
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "dir": "packages/core",
    "configFile": "packages/core/stryker.vitest.config.ts",
    "related": false
  },
  "thresholds": { "high": 95, "low": 92, "break": 86 }
}
